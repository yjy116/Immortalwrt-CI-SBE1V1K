 # The pin directory is created during normal startup, so it is not
 # a reliable leak indicator and must not block service lifecycle.
 #
 # The function stays sourceable by both init.d/daed and daed-guard.
 
+daed_datapath_idle() {
+	local process status reason
+	for process in honk-core dae; do
+		status=0
+		pidof "$process" >/dev/null || status=$?
+		case "$status" in
+			1) continue ;;
+			0) reason="$process is running" ;;
+			*) reason="cannot probe $process (pidof exit $status)" ;;
+		esac
+		echo "daed: refusing start/cleanup: $reason; shared datapath left untouched" >&2
+		logger -t daed-init "refusing start/cleanup: $reason; shared datapath left untouched"
+		return 1
+	done
+	return 0
+}
+
 daed_process_probe() {
 	if command -v pgrep >/dev/null 2>&1; then
 		pgrep -f '^/usr/bin/daed([[:space:]]|$)' >/dev/null 2>&1
 		case "$?" in
 			0) return 0 ;;
@@ -34,10 +51,11 @@ daed_process_probe() {
 	return 2
 }
 
