diff --git a/dae/files/dae.init b/dae/files/dae.init
index 1557dff..28ebfa5 100644
--- a/dae/files/dae.init
+++ b/dae/files/dae.init
@@ -8,17 +8,36 @@ extra_command "hot_reload" "Hot-reload service"
 
 CONF="dae"
 PROG="/usr/bin/dae"
 LOG_DIR="/var/log/dae"
 
+dae_datapath_idle() {
+	local process status reason
+	for process in honk-core daed; do
+		status=0
+		pidof "$process" >/dev/null || status=$?
+		case "$status" in
+			1) continue ;;
+			0) reason="$process is running" ;;
+			*) reason="cannot probe $process (pidof exit $status)" ;;
+		esac
+		echo "dae: refusing start/cleanup: $reason; shared datapath left untouched" >&2
+		logger -t dae-init "refusing start/cleanup: $reason; shared datapath left untouched"
+		return 1
+	done
+	return 0
+}
+
 start_service() {
+	DAE_START_STATUS=1
 	config_load "$CONF"
 
 	local enabled
 	config_get_bool enabled "config" "enabled" "0"
 	[ "$enabled" -eq "1" ] || return 1
 
+	dae_datapath_idle || return 1
 	# Both backends share eBPF attachments; selection also applies at boot/CLI.
 	local active_backend
 	active_backend="$(uci -q get daede.config.active_backend)"
 	if [ "$active_backend" != "$CONF" ] || pidof daed >/dev/null 2>&1; then
 		logger -t dae-init 'Start refused: select dae and stop daed first.'
@@ -47,14 +66,22 @@ start_service() {
 	procd_set_param limits nofile="1000000 1000000"
 	procd_set_param respawn
 	# procd_set_param stdout 1
 	procd_set_param stderr 1
 
-	procd_close_instance
+	procd_close_instance || return 1
+	DAE_START_STATUS=0
+}
+
+# rc.common does not propagate start_service's return status.
+service_started() {
+	return "$DAE_START_STATUS"
 }
 
 stop_service() {
+	DAE_STOP_STATUS=0
+	dae_datapath_idle || { DAE_STOP_STATUS=1; return 1; }
 	rm -rf "$LOG_DIR"
 	# kill lingering procs in daens: TERM first, then KILL for stubborn ones
 	for pid in $(ip netns pids daens 2>/dev/null); do kill "$pid" 2>/dev/null; done
 	if [ -n "$(ip netns pids daens 2>/dev/null)" ]; then
 		sleep 1
@@ -67,10 +94,15 @@ stop_service() {
 	fi
 	# clean orphaned dae0
 	ip link del dae0 2>/dev/null || true
 }
 
+# rc.common does not propagate stop_service's return status.
+service_stopped() {
+	return "$DAE_STOP_STATUS"
+}
+
 service_triggers() {
 	procd_add_reload_trigger "$CONF"
 }
 
